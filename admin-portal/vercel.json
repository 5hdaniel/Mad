{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh ../scripts/vercel-ignore-build.sh admin-portal",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true,
      "int/**": true,
      "*-portal/**": true,
      "portal/**": true,
      "dependabot/**": true,
      "hotfix/**": true,
      "release/**": true,
      "**": false
    }
  },
  "installCommand": "cd .. && npm ci --ignore-scripts --include=dev",
  "crons": [
    {
      "path": "/api/cron/storage-check",
      "schedule": "0 9 * * *"
    }
  ]
}
